<Window x:Class="LastLogon.AdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load computers from Active Directory"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="24">
        <TextBlock Text="Computer name prefix (blank = all)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="PrefixBox" Padding="6,4" Margin="0,0,0,12"
                 AutomationProperties.Name="Computer name prefix" />
        <TextBlock Text="OU distinguished name (optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="OuBox" Padding="6,4" Margin="0,0,0,4"
                 AutomationProperties.Name="OU distinguished name" />
        <TextBlock Text="e.g. OU=Workstations,DC=corp,DC=local" Foreground="#666" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Search" IsDefault="True" Padding="14,6" MinWidth="80" Margin="0,0,8,0" Click="Search_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="14,6" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
