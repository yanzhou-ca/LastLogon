<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LastLogon</RootNamespace>
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LastLogon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!--
      The profile is chosen by the runtime identifier and not by the platform: with several
      runtime identifiers the build uses a platform specific output path, and a profile name
      built from that platform does not exist.
    -->
    <PublishProfile Condition="'$(PublishProfile)' == '' and '$(RuntimeIdentifier)' != ''">win-$(RuntimeIdentifier.Replace('win-','')).pubxml</PublishProfile>
    <UseWPF>true</UseWPF>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="LastLogon.Core\**;LastLogon.Tests\**" />
    <Content Remove="LastLogon.Core\**;LastLogon.Tests\**" />
    <EmbeddedResource Remove="LastLogon.Core\**;LastLogon.Tests\**" />
    <None Remove="LastLogon.Core\**;LastLogon.Tests\**" />
    <Page Remove="LastLogon.Core\**;LastLogon.Tests\**;MainWindow.xaml;LookupWindow.xaml" />
  </ItemGroup>

  <!--
    The windows10.0.19041.0 target framework adds the Windows SDK projections as a framework
    reference: Microsoft.Windows.SDK.NET.dll (24 MB of WinRT metadata) and WinRT.Runtime.dll, from
    the Microsoft.Windows.SDK.NET.Ref pack. This application is plain WPF and never calls a WinRT
    API, so the SDK is told not to add that reference. The compiler is then not handed the
    projections, and they never end up in the build output.

    This replaces a target that removed the pack's known framework reference by its name. The
    .NET 10 SDK names those references differently, so that target stopped doing anything and
    gave no message, and removing only the known references leaves a framework reference that the
    SDK rejects (NETSDK1073). The restore still downloads the pack (12 MB), as it does the other
    known framework packs, in case a package refers to them; nothing in the build uses it.
  -->
  <PropertyGroup>
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
  </PropertyGroup>

  <!-- The icon of the program: the executable carries it, and the windows show the same file. -->
  <ItemGroup>
    <Resource Include="Assets\LastLogon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="LastLogon.Core\LastLogon.Core.csproj" />
  </ItemGroup>
  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Publish properties.

    The publish shape is decided by the profile in Properties\PublishProfiles:
      win-$(Platform).pubxml             framework dependent, one file, needs the .NET Desktop Runtime
      standalone-win-$(Platform).pubxml   self contained, one file, no prerequisites

    ReadyToRun is off by default: it adds roughly 55 MB to the payload and only shortens the
    start of a tool that is used a handful of times a day.
    Trimming stays off because WPF cannot be trimmed - a trimmed build fails at run time.
  -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
