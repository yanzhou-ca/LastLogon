<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="LastLogon.LookupWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:core="using:LastLogon.Core"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Last Profile Activity">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid Padding="24,16,24,16" RowSpacing="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<RadioButtons x:Name="ModeSelector" Grid.Row="0" MaxColumns="2" SelectedIndex="0"
					  Header="Lookup" SelectionChanged="ModeSelector_SelectionChanged">
			<RadioButton Content="By computer: who used this PC" />
			<RadioButton Content="By user: which PCs did this user use" />
		</RadioButtons>

		<StackPanel Grid.Row="1" Spacing="8">
			<TextBox x:Name="UsernameBox" Header="Username (jdoe, CORP\jdoe or jdoe@corp.local)"
					 Visibility="Collapsed" Text="{x:Bind Vm.Username, Mode=TwoWay}" />
			<TextBox x:Name="ComputersBox" Header="Computer name" AcceptsReturn="True"
					 TextWrapping="Wrap" MinHeight="40" MaxHeight="120"
					 Text="{x:Bind Vm.ComputersText, Mode=TwoWay}" />
			<StackPanel x:Name="ListButtons" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
				<Button Content="Import .txt…" Click="Import_Click" />
				<Button Content="From AD…" Click="FromAd_Click" />
			</StackPanel>
		</StackPanel>

		<Grid Grid.Row="2" ColumnSpacing="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
				<Button x:Name="ScanButton" Content="Scan" Style="{StaticResource AccentButtonStyle}"
						MinWidth="88" Click="Scan_Click" />
				<Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsEnabled="False" Click="Cancel_Click" />
				<ProgressRing x:Name="Ring" IsActive="False" Width="20" Height="20" />
			</StackPanel>
			<NumberBox x:Name="StaleBox" Grid.Column="1" Header="Stale after (days)" Value="90" Minimum="1"
					   SpinButtonPlacementMode="Compact" ValueChanged="StaleBox_ValueChanged" Width="150" />
			<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
				<Button Click="Copy_Click" ToolTipService.ToolTip="Copy selected rows (or all)">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE8C8;" FontSize="14" />
						<TextBlock Text="Copy" />
					</StackPanel>
				</Button>
				<Button Click="Export_Click" ToolTipService.ToolTip="Export results to CSV">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE74E;" FontSize="14" />
						<TextBlock Text="Export CSV" />
					</StackPanel>
				</Button>
				<Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open selected profile folder">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE8B7;" FontSize="14" />
						<TextBlock Text="Open folder" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<Grid Grid.Row="3">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid ColumnSpacing="8" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
				  CornerRadius="4,4,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="140" />
					<ColumnDefinition Width="140" />
					<ColumnDefinition Width="150" />
					<ColumnDefinition Width="80" />
					<ColumnDefinition Width="90" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0" Text="Computer" FontWeight="SemiBold" />
				<TextBlock Grid.Column="1" Text="Username" FontWeight="SemiBold" />
				<TextBlock Grid.Column="2" Text="Last profile activity" FontWeight="SemiBold" />
				<TextBlock Grid.Column="3" Text="Days ago" FontWeight="SemiBold" />
				<TextBlock Grid.Column="4" Text="Source" FontWeight="SemiBold" />
				<TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" />
			</Grid>
			<ListView x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind Vm.Results}"
					  SelectionMode="Extended" ContainerContentChanging="ResultsList_ContainerContentChanging">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="core:ProfileResult">
						<Grid ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140" />
								<ColumnDefinition Width="140" />
								<ColumnDefinition Width="150" />
								<ColumnDefinition Width="80" />
								<ColumnDefinition Width="90" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="{x:Bind Computer}" TextTrimming="CharacterEllipsis" />
							<TextBlock Grid.Column="1" Text="{x:Bind Username}" TextTrimming="CharacterEllipsis" />
							<TextBlock Grid.Column="2" Text="{x:Bind LastActivityText}" />
							<TextBlock Grid.Column="3" Text="{x:Bind DaysAgoText}" />
							<TextBlock Grid.Column="4" Text="{x:Bind SourceText}" />
							<TextBlock Grid.Column="5" Text="{x:Bind StatusText}" TextTrimming="CharacterEllipsis" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Grid>

		<TextBlock Grid.Row="4" Text="{x:Bind Vm.StatusText, Mode=OneWay}"
				   Style="{StaticResource CaptionTextBlockStyle}"
				   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
	</Grid>
</Window>