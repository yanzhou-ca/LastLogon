<?xml version="1.0" encoding="utf-8"?>
<!--
  The build for a machine that does not have the .NET 8 Desktop Runtime: the runtime and WPF
  travel with the executable, so it runs anywhere. It is one compressed file of roughly 70 MB;
  WPF cannot be trimmed, so the .NET runtime is the floor for this shape.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishDir>publish\win-arm64-standalone\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>

